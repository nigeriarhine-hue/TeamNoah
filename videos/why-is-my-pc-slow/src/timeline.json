{
 "total": 53.857,
 "segments": {
  "hook1": {
   "scene": "hook",
   "text": "If your PC feels slow, don't start deleting random files.",
   "start": 0.3,
   "end": 3.98
  },
  "hook2": {
   "scene": "hook",
   "text": "Check these five things first.",
   "start": 4.1,
   "end": 5.579
  },
  "t1a": {
   "scene": "tip1",
   "text": "Number one: startup apps.",
   "start": 6.079,
   "end": 7.533
  },
  "t1b": {
   "scene": "tip1",
   "text": "If too many programs launch when Windows starts, your PC can feel slow before you even do anything.",
   "start": 7.753,
   "end": 13.751
  },
  "t2a": {
   "scene": "tip2",
   "text": "Number two: background apps.",
   "start": 14.301,
   "end": 15.808
  },
  "t2b": {
   "scene": "tip2",
   "text": "Something you aren't even using could still be taking up resources.",
   "start": 16.028,
   "end": 19.53
  },
  "t3a": {
   "scene": "tip3",
   "text": "Number three: free storage.",
   "start": 20.08,
   "end": 21.57
  },
  "t3b": {
   "scene": "tip3",
   "text": "If your drive is almost full, check what's actually taking up the space.",
   "start": 21.79,
   "end": 25.639
  },
  "t4a": {
   "scene": "tip4",
   "text": "Number four: CPU and memory.",
   "start": 26.189,
   "end": 28.073
  },
  "t4b": {
   "scene": "tip4",
   "text": "Look for apps or processes that keep using an unusually large amount.",
   "start": 28.293,
   "end": 32.551
  },
  "t5a": {
   "scene": "tip5",
   "text": "And number five: figure out whether the slowdown affects your whole PC or just one app.",
   "start": 33.101,
   "end": 38.288
  },
  "t5b": {
   "scene": "tip5",
   "text": "That tells you where to troubleshoot next.",
   "start": 38.538,
   "end": 40.33
  },
  "n1": {
   "scene": "bridge",
   "text": "If you don't want to check all of that manually,",
   "start": 40.93,
   "end": 43.037
  },
  "n2": {
   "scene": "checks",
   "text": "Noah can inspect your PC,",
   "start": 43.117,
   "end": 44.657
  },
  "n3": {
   "scene": "checks",
   "text": "explain what it finds,",
   "start": 44.757,
   "end": 46.014
  },
  "n4": {
   "scene": "plan",
   "text": "and show you what it recommends before you approve any changes.",
   "start": 46.114,
   "end": 49.382
  },
  "n5": {
   "scene": "cta",
   "text": "Free PC Check at onnoah.app.",
   "start": 49.832,
   "end": 51.957
  }
 },
