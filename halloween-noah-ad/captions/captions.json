 },
 {
  "id": "c07",
  "start": 17.04,
  "end": 18.27,
  "text": "and that lag?",
  "html": "and that lag?"
 },
 {
  "id": "c08",
  "start": 18.58,
  "end": 19.79,
  "text": "That's nightmare fuel.",
