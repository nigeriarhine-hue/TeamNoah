  "text": "and waits for your approval.",
  "html": "and waits for your <span class=\"hn\">approval.</span>"
 },
 {
  "id": "c17",
  "start": 38.66,
  "end": 39.97,
  "text": "No mystery fixes,",
  "html": "No mystery fixes,"
 },
 {
  "id": "c18",
  "start": 40.04,
  "end": 41.65,
  "text": "no scary surprises.",
  "html": "no scary surprises."
 },
 {
