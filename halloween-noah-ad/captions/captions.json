  "end": 14.83,
  "text": "spotty Wi-Fi,",
  "html": "spotty Wi-Fi,"
 },
 {
  "id": "c06",
  "start": 14.98,
  "end": 17.02,
  "text": "storage warnings creeping up on you,",
