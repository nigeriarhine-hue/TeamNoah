[
 {
  "id": "c01",
  "start": 0.68,
  "end": 5.75,
  "text": "This Halloween, let's make sure your computer gets more treats than tricks.",
  "html": "This Halloween, let's make sure your computer gets more treats than <span class=\"hs\">tricks.</span>"
 },
 {
  "id": "c02",
  "start": 6.08,
  "end": 7.19,
  "text": "Because honestly,",
  "html": "Because honestly,"
 },
 {
  "id": "c03",
  "start": 7.34,
  "end": 11.55,
  "text": "what's scarier than a PC that isn't performing at its fullest potential?",
  "html": "what's <span class=\"hs\">scarier</span> than a PC that isn't performing at its fullest potential?"
 },
 {
  "id": "c04",
  "start": 11.8,
  "end": 13.85,
  "text": "Things like crashing apps,",
  "html": "Things like crashing apps,"
 },
 {
  "id": "c05",
