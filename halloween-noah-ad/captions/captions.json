 },
 {
  "id": "c09",
  "start": 20.1,
  "end": 23.57,
  "text": "Maybe an outdated driver is casting a spell on your graphics.",
  "html": "Maybe an outdated driver is casting a spell on your graphics."
 },
 {
  "id": "c10",
  "start": 23.76,
  "end": 27.67,
  "text": "Or maybe your system just needs the real cause uncovered.",
  "html": "Or maybe your system just needs the real cause uncovered."
 },
 {
  "id": "c11",
  "start": 28.2,
  "end": 29.65,
  "text": "That's where Noah comes in.",
  "html": "That's where <span class=\"hn\">Noah</span> comes in."
 },
 {
  "id": "c12",
